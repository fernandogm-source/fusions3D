{
  "name": "fusions3d-api",
  "version": "1.0.0",
  "description": "API REST para Fusions3D, tienda de impresiones 3D",
  "main": "src/app.js",
  "scripts": {
    "dev": "nodemon src/app.js",
    "start": "node src/app.js",
    "seed": "node seed.js",
    "seed:reset": "node seed.js --reset --confirm-reset",
    "migrate:remove-variant-name": "node scripts/remove-print-variant-name.js",
    "migrate:user-roles": "node scripts/migrate-user-roles.js"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.9.5",
    "morgan": "^1.12.1",
    "slugify": "^1.6.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "argon2@0.45.1": true
  }
}
