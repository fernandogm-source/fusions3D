PORT=3000
MONGODB_URI=mongodb://localhost:27017/fusions3d
CORS_ORIGIN=http://localhost:4200
NODE_ENV=development
# Número de proxies de confianza delante de la API (p. ej. 1) o una IP/subred. Déjalo vacío si no hay proxy.
TRUST_PROXY=
JWT_SECRET=
JWT_EXPIRES_IN=1h
# Debe ser distinto de JWT_SECRET (mínimo 32 bytes aleatorios).
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d
AI_SERVICE_URL=http://localhost:3001/ai/v1
AI_SERVICE_KEY=<misma clave que AI_SERVICE_KEY en fusions3d-ai>
AI_REQUEST_TIMEOUT_MS=45000

