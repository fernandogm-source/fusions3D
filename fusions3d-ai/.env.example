PORT=3001
NODE_ENV=development

# Clave que el backend principal envía en la cabecera X-Internal-Api-Key
AI_SERVICE_KEY=<clave aleatoria de al menos 32 caracteres>

OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Modelos gratuitos separados por comas, probados en orden si uno falla
OPENROUTER_MODELS=openrouter/free
OPENROUTER_REFERER=http://localhost:3000
AI_REQUEST_TIMEOUT_MS=30000
